# AnyRB v0.2 — Meta AI backend configuration
# Copy this file to server/.env and fill in real values. NEVER commit server/.env.
META_API_KEY=LLM_your_key_here
META_BASE_URL=https://api.meta.ai/v1

# Muse Spark (JSON extraction / planning / memos). Contributor mode trains on
# inputs/outputs — fine for the hackathon demo, use Standard for real users.
META_MODEL_SPARK=muse-spark-1.3-contributor
META_MODEL_SPARK_STANDARD=muse-spark-1.3
META_MODEL_SAM=sam-3.1
META_MODEL_IMAGE=muse-image-1.0
META_MODEL_ASR=muse-voice-transcribe-1.0
META_REASONING_EFFORT=low
META_MAX_TOKENS=4000

# Server behaviour
# ANYRB_MOCK=1          # force mock mode (no network, deterministic)
# ANYRB_HOST=127.0.0.1
# ANYRB_PORT=8787
# ANYRB_CACHE_DIR=server/cache
# ANYRB_PROVENANCE_FILE=server/provenance.jsonl
# ANYRB_EVIDENCE_DIR=server/evidence
# ANYRB_RATE_LIMIT_RPM=120        # per-IP requests/minute across /api
# ANYRB_MAX_BODY_MB=16            # hard request body cap
